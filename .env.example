# Virtual Science Park environment template.
#   cp .env.example .env     then fill in your own values locally.
# Never commit .env. Every API key below stays EMPTY in this file.
#
# Models run on OpenRouter (https://openrouter.ai), one key per agent, so
# nothing heavy runs locally. Model ids use OpenRouter's "vendor/model" form,
# e.g. anthropic/claude-haiku-5.5 or openai/gpt-4o-mini.
#
# TO REVERT to a local model: in each agent block, comment out the
# "OpenRouter" lines and uncomment the "Local Ollama" lines, then start Ollama
# with: docker compose --profile ollama up -d

# ----------------------------------------------------------- Docker images
# Read by docker-compose.yml itself (not passed into the containers).
# Empty = latest published image; pin exact versions for the demo.
API_TAG=
UI_TAG=

# ---------------------------------------------------------------- seed data
# fixtures = the real companies; fixtures/mock = simulated test data.
SEED_DIR=fixtures

# Database and cache: only for running outside Docker (Compose sets both).
# DATABASE_URL=sqlite:///vsp.db
# CACHE_DIR=./.cache

# ------------------------------------------- profiler agent (Backend 2)
# Read by agents/profiler/config.py. MODEL_RUNTIME: api | ollama | empty (rule-based only)
# OpenRouter:
MODEL_RUNTIME=api
MODEL_BASE_URL=https://openrouter.ai/api/v1
MODEL_NAME=
MODEL_API_KEY=
# Local Ollama (revert):
# MODEL_RUNTIME=ollama
# OLLAMA_HOST=http://ollama:11434
# MODEL_NAME=<a model pulled into Ollama>
# NVIDIA (build.nvidia.com):
#   MODEL_BASE_URL=https://integrate.api.nvidia.com/v1
#   MODEL_NAME=nvidia/nemotron-3.5-bolt-e4b
# Optional profiler settings (defaults live in agents/profiler/config.py):
# PROFILER_USER_AGENT=<identifying bot name and contact for your team>
# PROFILER_MIN_INTERVAL=2.0
# PROFILER_TIMEOUT=20
# PROFILER_CACHE_DIR=<folder for profiler output; default under CACHE_DIR>
# PROFILER_PAGE_CACHE_DIR=<folder for fetched pages; default PROFILER_CACHE_DIR/pages>

# --------------------------------------------- matcher agent (Backend 3)
# Read by agents/matcher/config.py. Empty MATCHER_API_KEY = rule-based "why" text.
# OpenRouter:
MATCHER_BASE_URL=https://openrouter.ai/api/v1
MATCHER_MODEL=
MATCHER_API_KEY=
# NVIDIA (build.nvidia.com):
#   MATCHER_BASE_URL=https://integrate.api.nvidia.com/v1
#   MATCHER_MODEL=nvidia/nemotron-3.5-bolt-e4b
# Local Ollama (revert):
# MATCHER_BASE_URL=http://ollama:11434/v1
# MATCHER_MODEL=<a model pulled into Ollama>
# MATCHER_API_KEY=ollama

# ---------------------------------------------- chat guardrail (Backend 1)
# Read by api/chat/answer.py. Empty CHAT_API_KEY = answers built from the data alone.
# The provider follows the key: an NVIDIA key (nvapi-...) is sent to NVIDIA even if
# CHAT_BASE_URL still points at OpenRouter. An empty CHAT_MODEL uses the provider's default.
# NVIDIA (build.nvidia.com, free tier):
#   CHAT_BASE_URL=https://integrate.api.nvidia.com/v1
#   CHAT_MODEL=nvidia/nemotron-3.5-bolt-e4b
# OpenRouter:
CHAT_BASE_URL=https://openrouter.ai/api/v1
CHAT_MODEL=
CHAT_API_KEY=
# Seconds to wait for the chat model before answering from the data alone.
CHAT_TIMEOUT=15
# Local Ollama (revert):
# CHAT_BASE_URL=http://ollama:11434/v1
# CHAT_MODEL=<a model pulled into Ollama>
# CHAT_API_KEY=ollama

# ------------------------------------------- monitors agent (Backend 3)
# Read by agents/monitors/config.py. Its own key, separate from the matcher's.
# The current monitors are rule-based and don't call the model yet.
# OpenRouter:
MONITOR_BASE_URL=https://openrouter.ai/api/v1
MONITOR_MODEL=
MONITOR_API_KEY=
# Local Ollama (revert):
# MONITOR_BASE_URL=http://ollama:11434/v1
# MONITOR_MODEL=<a model pulled into Ollama>
# MONITOR_API_KEY=ollama
# Source settings (defaults live in agents/monitors/config.py):
# Seconds per monitor request. Vinnova's API is slow: a timeout means Vinnova
# stays empty for that refresh. 60 is safe.
MONITOR_REQUEST_TIMEOUT=60
# VINNOVA_API_URL=https://data.vinnova.se/api/utlysningar
# VINNOVA_ROUNDS_API_URL=https://data.vinnova.se/api/ansokningsomgangar
# VINNOVA_UPDATED_SINCE=<YYYY-MM-DD; default two years ago>
# BSP_EVENTS_FEED_URL=https://www.bluesciencepark.se/wp-json/wp/v2/event?per_page=100&_fields=date,link,title,content,excerpt
# Member companies whose own websites are checked for events, and the page limit per site:
# MEMBER_COMPANIES_PATH=fixtures/companies.json
# COMPANY_EVENT_MAX_PAGES=12

# ------------------------------------------------------------------- API
# Bearer tokens from POST /auth/login expire after this many hours.
SESSION_TTL_HOURS=12

# Refresh opportunities from the monitors when the API starts: startup | off.
# (Admins can also refresh with POST /admin/opportunities/refresh.)
OPPORTUNITY_REFRESH=startup

# When a source returns nothing (e.g. a Vinnova timeout) and nothing is stored for
# it yet, load its current items from fixtures/opportunities.json, labelled as a
# cached snapshot: on | off.
OPPORTUNITY_FALLBACK=on

# Browser origins of the UI allowed to call the API (CORS), comma-separated.
# The local dev server and the Lovable preview URL, e.g.
#   UI_ORIGIN=http://localhost:3000,https://<your-project>.lovable.app
UI_ORIGIN=http://localhost:3000,http://localhost:8080
