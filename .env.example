# Copy to .env (never commit .env). All LLM calls read these.
MODEL_RUNTIME=          # api | ollama
MODEL_NAME=
MODEL_API_KEY=          # only for MODEL_RUNTIME=api
OLLAMA_HOST=http://ollama:11434
SESSION_SECRET=change-me
# Seed data folder: fixtures (real data) or fixtures/mock (simulated, for development)
SEED_DIR=fixtures/mock
