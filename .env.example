# Virtual Science Park environment template.
#   cp .env.example .env     then fill in your own values locally.
# Never commit .env. Every API key below stays EMPTY in this file.
#
# Models run on OpenRouter (https://openrouter.ai), one key per agent, so
# nothing heavy runs locally. Model ids use OpenRouter's "vendor/model" form,
# e.g. anthropic/claude-haiku-5.5 or openai/gpt-4o-mini.
#
# TO REVERT to a local model: in each agent block, comment out the
# "OpenRouter" lines and uncomment the "Local Ollama" lines, then start Ollama
# with: docker compose --profile ollama up -d

# ---------------------------------------------------------------- seed data
# fixtures/mock (simulated) until real data is ingested, then: fixtures
SEED_DIR=fixtures/mock

# Database and cache: only for running outside Docker (Compose sets both).
# DATABASE_URL=sqlite:///vsp.db
# CACHE_DIR=./.cache

# ------------------------------------------- profiler agent (Backend 2)
# Read by agents/profiler/config.py. MODEL_RUNTIME: api | ollama | empty (rule-based only)
# OpenRouter:
MODEL_RUNTIME=api
MODEL_BASE_URL=https://openrouter.ai/api/v1
MODEL_NAME=
MODEL_API_KEY=
# Local Ollama (revert):
# MODEL_RUNTIME=ollama
# OLLAMA_HOST=http://ollama:11434
# MODEL_NAME=<a model pulled into Ollama>
# PROFILER_USER_AGENT=<identifying bot name and contact for your team>
# PROFILER_MIN_INTERVAL=2.0
# PROFILER_TIMEOUT=20

# --------------------------------------------- matcher agent (Backend 3)
# To be read by agents/matcher/config.py (replaces the old LLM_* names).
# Empty MATCHER_API_KEY = rule-based "why" text.
# OpenRouter:
MATCHER_BASE_URL=https://openrouter.ai/api/v1
MATCHER_MODEL=
MATCHER_API_KEY=
# Local Ollama (revert):
# MATCHER_BASE_URL=http://ollama:11434/v1
# MATCHER_MODEL=<a model pulled into Ollama>
# MATCHER_API_KEY=ollama

# ---------------------------------------------- chat guardrail (Backend 1)
# Read by api/chat/ (not built yet).
# OpenRouter:
CHAT_BASE_URL=https://openrouter.ai/api/v1
CHAT_MODEL=
CHAT_API_KEY=
# Local Ollama (revert):
# CHAT_BASE_URL=http://ollama:11434/v1
# CHAT_MODEL=<a model pulled into Ollama>
# CHAT_API_KEY=ollama

# ------------------------------------------- monitors agent (Backend 3)
# To be read by agents/monitors/config.py. Its own key, separate from the matcher's.
# OpenRouter:
MONITOR_BASE_URL=https://openrouter.ai/api/v1
MONITOR_MODEL=
MONITOR_API_KEY=
# Local Ollama (revert):
# MONITOR_BASE_URL=http://ollama:11434/v1
# MONITOR_MODEL=<a model pulled into Ollama>
# MONITOR_API_KEY=ollama
# Source settings (defaults live in agents/monitors/config.py):
# Seconds per monitor request. Vinnova's API often needs more than the code's
# default of 10; a timeout means Vinnova stays empty for that refresh.
MONITOR_REQUEST_TIMEOUT=30
# VINNOVA_API_URL=https://data.vinnova.se/api/utlysningar
# BSP_EVENTS_FEED_URL=https://www.bluesciencepark.se/evenemang/feed/

# ------------------------------------------------------------------- API
# Bearer tokens from POST /auth/login expire after this many hours.
SESSION_TTL_HOURS=12

# Refresh opportunities from the monitors when the API starts: startup | off.
# (Admins can also refresh with POST /admin/opportunities/refresh.)
OPPORTUNITY_REFRESH=startup

# Browser origins of the UI allowed to call the API (CORS), comma-separated.
# The local dev server and the Lovable preview URL, e.g.
#   UI_ORIGIN=http://localhost:3000,https://<your-project>.lovable.app
UI_ORIGIN=http://localhost:3000,http://localhost:8080
